# Copy to .env and fill in.  .env is git-ignored.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Add your ngrok host when tunnelling, e.g.:
# ALLOWED_HOSTS=127.0.0.1,localhost,abcd-1234.ngrok-free.app
# CSRF_TRUSTED_ORIGINS=https://abcd-1234.ngrok-free.app

# Public URL used for links sent into WhatsApp and Twilio signature checks.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- Database ---
# sqlite (default) or mysql
DB_ENGINE=sqlite
# DB_ENGINE=mysql
# DB_NAME=indore_ibus
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# --- Twilio WhatsApp ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Set False only for local curl testing of the webhook.
TWILIO_VALIDATE_SIGNATURE=True

# --- Booking behaviour ---
SEAT_HOLD_MINUTES=10
SESSION_IDLE_MINUTES=30
